# Invoice-Controller configuration — copy to `.env` and fill in ONE provider key.
#   cp .env.example .env
# `.env` is gitignored; never commit real keys.

# ── Provider preference order: OpenRouter → OpenAI → Gemini → Anthropic ──
# The first key present wins. OpenRouter is the recommended default: one key
# reaches many models, and the tool ships tuned for it.

# --- OpenRouter (recommended) ---------------------------------------------
# Note the underscored spelling; both OPEN_ROUTER_API_KEY and OPENROUTER_API_KEY are accepted.
OPEN_ROUTER_API_KEY=
# Model routed through OpenRouter for offer/Standort extraction. gemini-2.5-flash is the
# validated default: multimodal (needed for scanned-PDF vision), cheap, reliable.
# Avoid ":free" models for extraction — they return unreliable structured output.
OPENROUTER_MODEL=google/gemini-2.5-flash

# --- Direct providers (used only if no OpenRouter key is set) --------------
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-5-mini              # default when OpenAI is primary
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.5-flash        # default when Gemini is primary
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Full override (bypasses all of the above) -----------------------------
# Any pydantic_ai model string, e.g. openai-chat:gpt-5
# LLM_MODEL=

# ── OpenRouter data policy (A3, 2026-09-29) ─────────────────────────────
# OpenRouter routes each request to one of several hosts of the model, each with its
# own retention/training policy. By default the app requires hosts that do NOT store
# prompts (data_collection=deny). Also set the account-level switch at
# https://openrouter.ai/settings/privacy ("may train on your data" → off).
# OPENROUTER_DATA_COLLECTION=deny        # "allow" lifts the restriction
# OPENROUTER_ZDR=0                        # 1 = zero-data-retention endpoints only (may leave no host)
# OPENROUTER_PROVIDERS=                   # e.g. google-vertex,google-ai-studio — pin the hosts
# OPENROUTER_ALLOW_FALLBACKS=1            # 0 = never fall back to another host

# ── Web UI (docker compose; see docker-compose.yml) ──────────────────────
# The login gate: one password, no username. REQUIRED on a non-loopback bind — without
# it the UI refuses to serve rather than opening up. Failed logins are throttled per
# client address (5 failures / 5 min → 15 min lockout).
IC_WEB_PASSWORD=
# Stable session secret so logins survive restarts (any long random string).
#   openssl rand -hex 32
IC_WEB_STORAGE_SECRET=
# Hostname and TLS are configured in the shared Caddy stack (server-proxy/.env:
# INVOICE_HOST). That proxy no longer adds basic-auth — this login page is the gate.
