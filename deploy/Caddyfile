# Caddy reverse proxy for the Invoice-Controller web UI.
# - Automatic TLS (Let's Encrypt for a real IC_DOMAIN; internal CA for localhost).
# - basic_auth is the OUTER layer (replaces the old `ngrok --basic-auth` habit);
#   the app's IC_WEB_PASSWORD gate stays active as the inner layer.
# - reverse_proxy handles NiceGUI's websocket upgrade automatically.

{$IC_DOMAIN:localhost} {
	basic_auth {
		{$IC_BASIC_AUTH_USER} {$IC_BASIC_AUTH_HASH}
	}

	reverse_proxy app:8080

	# Client documents pass through here — keep proxy logs lean.
	log {
		output stderr
		level WARN
	}
}
